{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],

    "strict": true,
    "skipLibCheck": true,

    "module": "ESNext",
    "moduleResolution": "Bundler",

    "resolveJsonModule": true,
    "allowJs": false,

    "isolatedModules": true,
    "noEmit": true,

    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,

    "baseUrl": "."
  }
}
