{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "storybook-static/**"]
    },
    "preview": {
      "dependsOn": ["build"],
      "persistent": true
    },
    "start": {
      "dependsOn": ["build"],
      "persistent": true,
      "env": [
        "HTTP_PROXY",
        "HTTPS_PROXY",
        "NO_PROXY",
        "http_proxy",
        "https_proxy",
        "no_proxy"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^lint"],
      "cache": true,
      "inputs": ["src/**/*.ts", "src/**/*.tsx", "eslint.config.js"],
      "outputs": []
    },
    "lint:css": {},
    "check-types": {
      "dependsOn": ["^check-types"]
    }
  }
}
