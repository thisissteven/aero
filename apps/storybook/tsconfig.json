{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "noCheck": true,
    "noImplicitAny": false,
    "jsx": "react-jsx",
    "strict": false,
    "strictNullChecks": false,
    "skipDefaultLibCheck": false,
    "skipLibCheck": false,
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"]
    }
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    ".storybook/**/*.ts",
    ".storybook/**/*.tsx"
  ]
}
