{
  "name": "@aero/root",
  "private": true,
  "version": "0.0.0",
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "catalog": {
    "@heroui/react": "3.2.2",
    "@heroui/styles": "3.2.2",
    "@internationalized/date": "3.12.2",
    "@react-stately/data": "3.16.1",
    "@react-aria/utils": "3.34.1",
    "@react-types/shared": "3.36.0",
    "oxfmt": "0.61.0",
    "oxlint": "1.76.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-aria": "3.50.0",
    "react-aria-components": "1.19.0",
    "react-stately": "3.48.0",
    "tailwindcss": "4.3.3",
    "@tailwindcss/cli": "4.3.3",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/react-router": "1.170.17",
    "@tanstack/router-plugin": "1.168.19",
    "@tanstack/router-cli": "1.167.18",
    "@tanstack/react-query": "5.101.2",
    "viem": "2.55.0",
    "wagmi": "2.19.5",
    "@types/react": "19.2.17",
    "@types/node": "26.1.2",
    "@types/react-dom": "19.2.3",
    "typescript": "6.0.3",
    "tsdown": "0.22.14",
    "turbo": "2.10.7"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "preview": "turbo run preview",
    "lint": "turbo run lint",
    "lint:css": "turbo run lint:css",
    "format": "prettier --write .",
    "check-types": "turbo run check-types",
    "prepare": "husky",
    "storybook:dev": "turbo run dev --filter=@aero/storybook",
    "storybook:build": "turbo run build --filter=@aero/storybook",
    "storybook:preview": "turbo run preview --filter=@aero/storybook",
    "web:dev": "turbo run dev --filter=@aero/web",
    "web:build": "turbo run build --filter=@aero/web",
    "web:preview": "turbo run preview --filter=@aero/web"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.6.0",
    "@commitlint/config-conventional": "^19.6.0",
    "@eslint/js": "^9.17.0",
    "@tailwindcss/vite": "^4.3.3",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "eslint-plugin-storybook": "^0.11.0",
    "eslint-plugin-unused-imports": "^4.1.4",
    "globals": "^15.14.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.3.0",
    "prettier": "^3.4.0",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "stylelint": "^17.14.1",
    "stylelint-config-standard": "^40.0.0",
    "turbo": "^2.5.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.18.0"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix"
    ],
    "*.{ts,tsx,md,json,css}": [
      "prettier --write --ignore-unknown"
    ]
  }
}
