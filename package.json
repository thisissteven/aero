{
  "name": "@aero/root",
  "private": true,
  "version": "0.0.0",
  "packageManager": "bun@1.3.14",
  "workspaces": ["apps/*", "packages/*"],
  "catalog": {
    "@heroui/react": "^3.2.4",
    "@heroui/styles": "^3.2.4",
    "@internationalized/date": "3.12.2",
    "@react-stately/data": "3.16.1",
    "@react-aria/utils": "3.34.1",
    "@react-types/shared": "3.36.0",
    "next": "16.2.12",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-aria": "^3.51.0",
    "react-aria-components": "^1.20.0",
    "react-stately": "3.48.0",
    "tailwindcss": "4.3.3",
    "@tailwindcss/vite": "4.3.3",
    "@types/react": "19.2.17",
    "@types/node": "26.1.2",
    "@types/react-dom": "19.2.3",
    "typescript": "6.0.3",
    "tsdown": "0.22.14",
    "turbo": "2.10.7",
    "virtua": "^0.50.1"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "preview": "turbo run preview",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "lint:css": "turbo run lint:css",
    "check-types": "turbo run check-types",
    "prepare": "husky",
    "storybook:dev": "turbo run dev --filter=@aero/storybook",
    "storybook:build": "turbo run build --filter=@aero/storybook",
    "storybook:preview": "turbo run preview --filter=@aero/storybook",
    "web:dev": "turbo run dev --filter=@aero/web",
    "web:build": "turbo run build --filter=@aero/web",
    "web:start": "turbo run start --filter=@aero/web",
    "tree": "node ./scripts/tree.js"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.13",
    "@commitlint/cli": "^19.6.0",
    "@commitlint/config-conventional": "^19.6.0",
    "@tailwindcss/vite": "^4.3.3",
    "globals": "^15.14.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.3.0",
    "stylelint": "^17.14.1",
    "stylelint-config-standard": "^40.0.0",
    "turbo": "2.10.7",
    "typescript": "6.0.3"
  },
  "lint-staged": {
    "*.{js,ts,jsx,tsx,json,css}": [
      "biome check --write --no-errors-on-unmatched"
    ]
  }
}
