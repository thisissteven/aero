{
  "name": "@aero/cli",
  "version": "0.0.0",
  "description": "Aero CLI — unified interface for AI coding harnesses",
  "type": "module",
  "bin": { "aero": "./dist/index.js" },
  "files": ["dist"],
  "engines": { "node": ">=20" },
  "scripts": {
    "build": "tsup",
    "dev": "bun src/index.ts",
    "start": "bun src/index.ts",
    "lint": "bunx --bun eslint . --fix-dry-run --cache",
    "check-types": "tsc --noEmit",
    "test": "bun test"
  },
  "dependencies": {
    "@aero/web": "workspace:*",
    "commander": "^12.0.0"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@types/node": "catalog:",
    "tsup": "^8.3.5",
    "typescript": "catalog:"
  }
}
