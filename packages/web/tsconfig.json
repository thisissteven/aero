{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "paths": {
      "@/app/*": ["./app/*"],
      "@/server/*": ["./server/*"]
    }
  },
  "include": [
    "app/**/*.ts",
    "app/**/*.tsx",
    "vite.config.ts",
    "server/**/*.ts"
  ],
  "exclude": ["server/adapters/claude/*.ts", "server/adapters/codex/*.ts"]
}
